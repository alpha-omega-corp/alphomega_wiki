# OAuth login via the AOAuth server.
# Defaults match AOAuth's seeded `demo-client` (redirect http://localhost:3000/callback),
# so the flow works out of the box when AOAuth runs on :8080 and this app on :3000.
AOAUTH_ISSUER=http://localhost:8080
AOAUTH_CLIENT_ID=demo-client
AOAUTH_CLIENT_SECRET=demo-secret
AOAUTH_REDIRECT_URI=http://localhost:3000/callback

# Seals the session cookie. MUST be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SESSION_PASSWORD=dev-only-insecure-session-password-change-me!!

# Set to "true" to require login for every page.
AUTH_REQUIRED=false
