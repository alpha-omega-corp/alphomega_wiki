# OAuth login via the AOAuth server. These NUXT_* variables map to
# nuxt.config.ts `runtimeConfig.oauth` / `.session` / `.public` and are the
# single source of OAuth config for docs-app — nothing OAuth-related lives in
# docker-compose. Defaults match AOAuth's seeded `demo-client`.
NUXT_OAUTH_ISSUER=http://localhost:8080
# Server-side AOAuth URL (token exchange / userinfo / refresh). Same as the
# issuer for a local run; in Docker use http://host.docker.internal:8080.
NUXT_OAUTH_INTERNAL_URL=http://localhost:8080
NUXT_OAUTH_CLIENT_ID=demo-client
NUXT_OAUTH_CLIENT_SECRET=demo-secret
NUXT_OAUTH_REDIRECT_URI=http://localhost:3000/callback

# Seals the session cookie. MUST be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NUXT_SESSION_PASSWORD=dev-only-insecure-session-password-change-me!!

# Set to "true" to require login for every page.
NUXT_PUBLIC_AUTH_REQUIRED=false
